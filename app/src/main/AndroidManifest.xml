<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ResiSolve"
        tools:targetApi="31">

        <!-- Splash Activity (Launcher) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ResiSolve.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Activity -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <!-- Profile Creation Activity -->
        <activity
            android:name=".activities.ProfileCreationActivity"
            android:exported="false" />

        <!-- Resident Home Activity -->
        <activity
            android:name=".activities.ResidentHomeActivity"
            android:exported="false" />

        <!-- Admin Dashboard Activity -->
        <activity
            android:name=".activities.AdminDashboardActivity"
            android:exported="false" />

        <!-- Raise Issue Activity -->
        <activity
            android:name=".activities.RaiseIssueActivity"
            android:exported="false" />

        <!-- Issue Detail Activity -->
        <activity
            android:name=".activities.IssueDetailActivity"
            android:exported="false" />

        <!-- Profile Settings Activity -->
        <activity
            android:name=".activities.ProfileSettingsActivity"
            android:exported="false" />

        <!-- Notifications Activity -->
        <activity
            android:name=".activities.NotificationsActivity"
            android:exported="false" />

    </application>

</manifest>